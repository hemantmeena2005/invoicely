# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_generate_with_openssl_rand_base64_32

# Google OAuth (Optional - Demo Sign-in is available without Google OAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Supabase (PostgreSQL Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Brevo (Sendinblue) Email Service - 300 free emails/day
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_NAME="Invoice Hub"
BREVO_SENDER_EMAIL=your-verified-brevo-email@domain.com

# Default UPI ID for Payments
NEXT_PUBLIC_DEFAULT_UPI_ID=yourname@oksbi

# App URL for absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000
